# Flask secret key used for session signing + CSRF. Generate your own for anything
# beyond local single-user development, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

# Flask environment selection: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi.py

# SQLite database file path. Relative paths resolve inside the instance/
# folder automatically (so "app.sqlite3" -> instance/app.sqlite3); absolute
# paths are used as-is. Do not prefix with "instance/" yourself.
DATABASE_PATH=app.sqlite3

# Local asset storage root (uploaded/imported images). Same relative/absolute
# rule as DATABASE_PATH.
ASSETS_PATH=assets

# Host/port for `flask run`.
HOST=127.0.0.1
PORT=5000

# Max upload size for image assets, in megabytes.
MAX_UPLOAD_MB=8
